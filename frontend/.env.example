# 1. Mock Data Toggle
# Set to 'true' for local UI demos with mock data; set to 'false' to talk to the real backend.
VITE_USE_MOCK=false

# 2. External API Mode Toggle
# Set to 'true' if the frontend and backend are hosted on separate domains/ports.
# Set to 'false' (or omit) to use a relative path ('') for the bundled monolith setup.
VITE_USE_EXTERNAL_API=false

# 3. Target API Base URL
# Only used if VITE_USE_EXTERNAL_API is set to 'true'. 
# (e.g., http://localhost:8080 during local testing, or https://api.yourdomain.com in production)
VITE_API_BASE_URL=